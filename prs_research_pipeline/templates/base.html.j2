<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ui.title }} — {{ sample_id }}</title>
    <style>{{ css|safe }}</style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
    <section class="print-cover">
        <div class="cover-title">
            <h1>{{ ui.title }}</h1>
            <div class="subtitle">{{ ui.subtitle }}</div>
        </div>
        <table class="cover-meta">
            <tr><th>{{ cover_labels.sample }}</th><td>{{ sample_id }}</td></tr>
            <tr><th>{{ cover_labels.population }}</th><td>{{ pop }}</td></tr>
            <tr><th>{{ cover_labels.generated }}</th><td>{{ now }}</td></tr>
            <tr><th>{{ cover_labels.version }}</th><td>BlueGen v{{ pipeline_version }} · GRCh37/hg19</td></tr>
        </table>
        <nav class="print-toc">
            <h2>{{ toc_label }}</h2>
            <ol>
            {% for section_id, title in toc %}
                <li><a href="#{{ section_id }}">{{ title }}</a></li>
            {% endfor %}
            </ol>
        </nav>
    </section>
    <header class="report-header" data-sample="{{ sample_id }}">
        <h1>{{ ui.title }}</h1>
        <div class="subtitle">{{ ui.subtitle }}</div>
        <div class="meta">
            Sample: {{ sample_id }} | Population: {{ pop }} | Integrity: {{ integrity_score_fmt }}/100<br>
            Generated: {{ now }} | BlueGen v{{ pipeline_version }} | GRCh37/hg19
        </div>
    </header>
    <div class="container">
        {{ reference_coverage_banner_html|safe }}
        <div class="btn-row">
            <button class="btn" onclick="expandAll()">📖 Expand All</button>
            <button class="btn" onclick="collapseAll()">📕 Collapse All</button>
        </div>
        {{ sections_html|safe }}
    </div>
    <footer class="report-footer">
        <p>BlueGen Report — Generated {{ now }}</p>
        <p>BlueGen v{{ pipeline_version }} | Sample: {{ sample_id }} | Research Use Only</p>
    </footer>
    <script>{{ js|safe }}</script>
</body>
</html>