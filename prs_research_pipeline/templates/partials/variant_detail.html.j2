{% for t in trait_sections %}
<h4>{{ t.trait }} <span style="font-weight:400;color:#7f8c8d">({{ t.n_used }}/{{ t.n_total }} SNPs used)</span></h4>
<table>
    <thead><tr><th>rsID</th><th>Gene</th><th>Effect Allele</th><th>Weight (β)</th><th>Evidence</th></tr></thead>
    <tbody>{% for v in t.variants %}
        <tr><td>{{ v.rsid }}</td><td>{{ v.gene }}</td><td>{{ v.effect_allele }}</td><td>{{ v.weight }}</td><td>{{ v.ev_badge|safe }}</td></tr>{% else %}
        <tr><td colspan='5' style='color:#7f8c8d'>SNP database not available. Run with --snp-db to populate.</td></tr>{% endfor %}
    </tbody>
</table>
{% endfor %}
<div class="highlight-box" style="background:#eaf2f8;border:1px solid #aed6f1;border-radius:8px;padding:0.8rem 1.2rem;margin-top:0.5rem">
    {{ evidence_legend|safe }}
    <p style="font-size:0.72rem;color:var(--color-text-secondary);margin:0">{{ weight_note }}</p>
</div>