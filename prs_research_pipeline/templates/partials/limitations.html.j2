<h4>Per-Trait Confidence Notes</h4>
<ul style="font-size:0.82rem;line-height:1.6;margin-bottom:1.5rem">{% for n in trait_notes %}
    <li><strong>{{ n.trait }}:</strong> {{ n.text }}</li>{% endfor %}
</ul>
<div class="disclaimer-box">
<h3>⚠️ Important Disclaimer</h3>
<p style="white-space:pre-line">{{ disclaimer }}</p>
</div>