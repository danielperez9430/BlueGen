<div class="info-grid">
    <div class="info-card"><h4>Run ID</h4><div class="big-stat" style="font-size:0.8rem;word-break:break-all">{{ run_id }}</div></div>
    <div class="info-card"><h4>Reproducibility Score</h4><div class="big-stat" style="color:#27ae60">{{ repro_score }}/100</div></div>
    <div class="info-card"><h4>Pipeline Version</h4><div class="big-stat">v{{ pipeline_version }}</div></div>
    <div class="info-card"><h4>Global Seed</h4><div class="big-stat">{{ global_seed }}</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1rem">
    <div>
        <h4>System Environment</h4>
        <table><tbody>
        <tr><td>OS</td><td>{{ os_name }} {{ os_version }} ({{ architecture }})</td></tr>
        <tr><td>Python</td><td>{{ python_version }} ({{ python_implementation }})</td></tr>
        <tr><td>Kernel</td><td style="font-size:0.7rem;word-break:break-all">{{ kernel }}</td></tr>
        </tbody></table>
    </div>
    <div>
        <h4>Bioinformatics Tools</h4>
        <table><thead><tr><th>Tool</th><th>Version</th></tr></thead><tbody>{% for t in tools %}
            <tr><td>{{ t.tool }}</td><td style='font-size:0.78rem'>{{ t.version }}</td></tr>{% endfor %}
        </tbody></table>
    </div>
</div>

<h4 style="margin-top:1.5rem">Python Packages (selected)</h4>
<table><thead><tr><th>Package</th><th>Version</th></tr></thead><tbody>{% for p in packages %}
    <tr><td>{{ p.pkg }}</td><td>{{ p.ver }}</td></tr>{% endfor %}
</tbody></table>

<h4 style="margin-top:1.5rem">Seeds Registry</h4>
<table><thead><tr><th>Module</th><th>Seed</th></tr></thead><tbody>
<tr><td>Global</td><td>{{ global_seed_table }}</td></tr>
<tr><td>NumPy</td><td>{{ numpy_seed }}</td></tr>
<tr><td>Python hash</td><td>{{ python_hash_seed }}</td></tr>
<tr><td>Scikit-learn</td><td>{{ sklearn_seed }}</td></tr>
<tr><td>PLINK</td><td>{{ plink_seed }}</td></tr>
<tr><td>Bootstrap 0</td><td>{{ bootstrap_seed_0 }}</td></tr>
</tbody></table>